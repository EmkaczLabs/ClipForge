# ClipForge Website Environment Variables
# Copy to .env.local for local development. Never commit real credentials.

# Public site URL
NEXT_PUBLIC_SITE_URL=https://clipforge.emkacz.dev

# RustFS S3-compatible release storage (read-only release-scoped credentials)
RUSTFS_ENDPOINT=https://s3.emkacz.dev
RUSTFS_BUCKET=clipforge-builds
RUSTFS_REGION=us-east-1
RUSTFS_RELEASE_ACCESS_KEY_ID=
RUSTFS_RELEASE_SECRET_ACCESS_KEY=
